          "custom": {"align": "center", "cellOptions": {"type": "color-background"}}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "team_a\\team_b"},
            "properties": [
              {"id": "displayName", "value": "Equipo"},
              {"id": "custom.cellOptions", "value": {"type": "auto"}},
              {"id": "links", "value": [{"title": "Abrir la ficha del equipo", "url": "/d/acr-equipo?var-equipo=${__value.raw}"}]}
            ]
          }
        ]
      },
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["count"], "countRows": false}}
    },
