    {
      "id": 5,
      "type": "table",
      "title": "Similitud entre equipos",
      "description": "Matriz equipo × equipo con la mayor similitud de Dolos entre dos de sus archivos (0 a 100 %). Filas: equipos elegidos en la variable; columnas: todos los equipos comparados.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
