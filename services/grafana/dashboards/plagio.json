    {
      "id": 1,
      "type": "text",
      "title": "5. Plagio",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "**Código externo, similitud entre equipos, ideas en la web e historial de git.** SCANOSS, Dolos, la búsqueda web con Claude Code y las señales de git, resumidos en `reports/plagiarism.json` (`acr plagiarism` o `acr analyze`). **Una coincidencia indica similitud, no copia confirmada:** la decisión es del revisor, después de confirmar con los organizadores si se permiten plantillas, código previo o código generado con IA."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Coincidencias con código externo",
      "description": "Archivos o fragmentos con coincidencia en proyectos open source conocidos (SCANOSS).",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 3},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files:8080/reports/plagiarism.json",
          "url_options": {"method": "GET", "data": ""},
          "root_selector": "teams",
          "columns": [
            {"selector": "team", "text": "Equipo", "type": "string"},
            {"selector": "external_matches", "text": "Coincidencias con código externo", "type": "number"}
          ],
          "filterExpression": "team IN (${equipo:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["sum"], "fields": "/^Coincidencias con código externo$/", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pares de equipos similares",
      "description": "Pares de equipos entre los que Dolos encontró archivos similares; cada par cuenta una vez.",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 3},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files:8080/reports/plagiarism.json",
          "url_options": {"method": "GET", "data": ""},
          "root_selector": "team_pairs",
          "columns": [
            {"selector": "team_a", "text": "Equipo A", "type": "string"},
            {"selector": "team_b", "text": "Equipo B", "type": "string"},
            {"selector": "similar", "text": "Pares similares", "type": "number"}
          ],
          "filterExpression": "team_a IN (${equipo:singlequote}) || team_b IN (${equipo:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Sin datos",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["sum"], "fields": "/^Pares similares$/", "values": false},
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
