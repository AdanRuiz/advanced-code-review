{
  "uid": "acr-resumen",
  "title": "1. Resumen",
  "description": "Comparar a todos los equipos",
  "tags": ["advanced-code-review"],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {"from": "now-30d", "to": "now"},
  "refresh": "",
  "graphTooltip": 0,
  "links": [
    {
      "title": "Advanced Code Review",
      "type": "dashboards",
      "tags": ["advanced-code-review"],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    },
    {"title": "PDF equipo", "type": "link", "url": "http://localhost:8080/reports/${equipo}/reporte.pdf", "tooltip": "Descargar el reporte del equipo seleccionado en PDF (con Todos o varios equipos: el ZIP)", "icon": "doc", "targetBlank": true, "includeVars": false, "keepTime": false, "asDropdown": false, "tags": []},
    {"title": "MD equipo", "type": "link", "url": "http://localhost:8080/reports/${equipo}/reporte.md", "tooltip": "Descargar el reporte del equipo seleccionado en Markdown (con Todos o varios equipos: el ZIP)", "icon": "doc", "targetBlank": true, "includeVars": false, "keepTime": false, "asDropdown": false, "tags": []},
    {"title": "ZIP todos", "type": "link", "url": "http://localhost:8080/reports/todos.zip", "tooltip": "Descargar los reportes de todos los equipos y los CSV de Dolos", "icon": "doc", "targetBlank": true, "includeVars": false, "keepTime": false, "asDropdown": false, "tags": []}
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "equipo",
        "label": "Equipo",
        "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
        "query": {
          "refId": "variable",
          "queryType": "infinity",
          "query": "",
          "infinityQuery": {
            "refId": "variable",
            "type": "json",
            "source": "url",
            "parser": "backend",
            "format": "table",
            "url": "http://files:8080/reports/status.json",
            "url_options": {"method": "GET", "data": ""},
            "root_selector": "teams",
            "columns": [{"selector": "id", "text": "id", "type": "string"}]
          }
        },
        "definition": "Infinity: /reports/status.json -> teams[].id",
        "multi": true,
        "includeAll": true,
        "current": {},
        "options": [],
        "refresh": 1,
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "1. Resumen",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "**Comparar a todos los equipos.** El estado del análisis sale de `reports/status.json` (`acr analyze`) y las alertas de plagio de `reports/plagiarism.json` (`acr plagiarism` o `acr analyze`). Los demás paneles de esta página llegan con PB-18 (SPEC.md, sección \"1. Resumen\")."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Estado del análisis",
      "description": "Por equipo: pendiente / obteniendo / analizando / listo / error y hora de la última corrida (orquestador, reports/status.json).",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 3},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files:8080/reports/status.json",
          "url_options": {"method": "GET", "data": ""},
          "root_selector": "teams",
          "columns": [
            {"selector": "id", "text": "Equipo", "type": "string"},
            {"selector": "nombre", "text": "Nombre", "type": "string"},
            {"selector": "state", "text": "Estado", "type": "string"},
            {"selector": "finished_at", "text": "Última corrida", "type": "timestamp"}
          ],
          "filterExpression": "id IN (${equipo:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {"noValue": "Sin datos", "custom": {"align": "auto", "filterable": true}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Estado"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "pendiente": {"text": "pendiente", "color": "text", "index": 0},
                      "obteniendo": {"text": "obteniendo", "color": "blue", "index": 1},
                      "analizando": {"text": "analizando", "color": "yellow", "index": 2},
                      "listo": {"text": "listo", "color": "green", "index": 3},
                      "error": {"text": "error", "color": "red", "index": 4}
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Última corrida"},
            "properties": [
              {"id": "unit", "value": "dateTimeAsLocal"},
              {"id": "mappings", "value": [{"type": "special", "options": {"match": "null", "result": {"text": "sin corrida", "index": 0}}}]}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Equipo"},
            "properties": [{"id": "links", "value": [{"title": "Abrir la ficha del equipo", "url": "/d/acr-equipo?var-equipo=${__value.raw}"}]}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{"displayName": "Equipo", "desc": false}],
        "footer": {"show": false, "reducer": ["count"], "countRows": false}
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Alertas de plagio",
      "description": "Equipos con coincidencias en SCANOSS (código externo), Dolos (otros equipos con archivos similares) o la web (proyectos parecidos), y cuántas. Una coincidencia indica similitud, no copia confirmada: el detalle está en la página Plagio.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 11},
      "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "acr-infinity"},
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "http://files:8080/reports/plagiarism.json",
          "url_options": {"method": "GET", "data": ""},
          "root_selector": "teams",
          "columns": [
            {"selector": "team", "text": "Equipo", "type": "string"},
            {"selector": "external_matches", "text": "SCANOSS", "type": "number"},
            {"selector": "similar_teams", "text": "Dolos", "type": "number"},
            {"selector": "web_matches", "text": "Web", "type": "number"}
          ],
          "filterExpression": "team IN (${equipo:singlequote}) && (external_matches > 0 || similar_teams > 0 || web_matches > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Sin alertas de plagio",
          "decimals": 0,
          "custom": {"align": "auto", "filterable": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "SCANOSS"},
            "properties": [
              {"id": "description", "value": "Coincidencias con código open source conocido (reports/<id>/scanoss.json)"},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Dolos"},
            "properties": [
              {"id": "description", "value": "Otros equipos con archivos similares (reports/dolos/pairs.csv)"},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Web"},
            "properties": [
              {"id": "description", "value": "Proyectos parecidos en la web (reports/<id>/web-plagiarism.json)"},
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Equipo"},
            "properties": [{"id": "links", "value": [{"title": "Abrir la ficha del equipo", "url": "/d/acr-equipo?var-equipo=${__value.raw}"}]}]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{"displayName": "Equipo", "desc": false}],
        "footer": {"show": false, "reducer": ["count"], "countRows": false}
      }
    }
  ]
}
